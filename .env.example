# Template only. Copy this to `.env` and put the real values THERE.
# `.env` is gitignored; this file is committed, so it must never hold a real key.

# ─── Supabase ────────────────────────────────────────────────────────────
# Both URLs hold the same value. Everything is under Settings → API Keys.

# Shipped to the browser by Vite. The anon key is public by design —
# Row Level Security is what stops a visitor from editing the catalogue.
VITE_SUPABASE_URL="https://xxxxxxxxxxxxxxxx.supabase.co"
VITE_SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"

# Used only by the scripts in scripts/ and by the GitHub Action.
# service_role bypasses every RLS policy — treat it like a root password.
# Never paste it into a chat, a screenshot, or any committed file.
SUPABASE_URL="https://xxxxxxxxxxxxxxxx.supabase.co"
SUPABASE_SERVICE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"

# ─── PostHog ─────────────────────────────────────────────────────────────
# Project settings → Project API key. It is write-only and public, so it
# ships to the browser. Leave it empty and no events are sent at all.
# Host is https://us.i.posthog.com for US cloud, https://eu.i.posthog.com for EU.
VITE_POSTHOG_KEY="phc_MY_PROJECT_KEY"
VITE_POSTHOG_HOST="https://us.i.posthog.com"

# ─── AI Studio / admin panel ─────────────────────────────────────────────

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Secure Admin Configuration
ADMIN_PASSWORD="CHOOSE_A_STRONG_PASSWORD"
JWT_SECRET=

# Google OAuth 2.0 Credentials (for Company Gmail Sign-In)
# Obtain these from the Google Cloud Console (APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated list of authorized Gmail addresses allowed to access the admin panel
ALLOWED_ADMIN_EMAILS="nave1237@gmail.com"
